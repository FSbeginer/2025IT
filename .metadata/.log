		add(checkBox);
		
		load();
	}

	List<E_Panel> pps = new 
	private void load() {
		panel.removeAll();
		
		try (var rs = res("select pno,ctno, img, pname, price,cart.quantity,price*cart.quantity tot from cart join product using(pno) where uno = "+BF.uno)) {
			int w = (scrollPane.getWidth()-25)/3;
			int h = scrollPane.getHeight()/3;
			int i = 0;
			while(rs.next()) {
				E_Panel pp =new E_Panel(getIcon(rs.getBytes(3),100,100), rs.getString(4), rs.getInt(5), rs.getInt(6), rs.getInt(7));
				pp.setSize(w, h);
				pp.setLocation(w*(i%3), h*(i/3));
				pp.checkBox.addItemListener(new ItemListener() {
					@Override
					public void itemStateChanged(ItemEvent e) {
						
					}
				});
				
				i++;
			}
		} catch (SQLException e) {
			e.printStackTrace();
		}
		
		panel.revalidate();
		panel.repaint();
	}
}

