import javax.swing.JPanel;
import javax.swing.JPopupMenu;

import java.awt.Color;

import javax.swing.Icon;
import javax.swing.JLabel;
import javax.swing.JMenuItem;

import java.awt.Font;
import java.sql.SQLException;
import java.util.ArrayList;
import java.util.List;

import javax.swing.SwingConstants;
import javax.swing.SwingUtilities;
import javax.swing.table.DefaultTableCellRenderer;
import javax.swing.table.DefaultTableModel;
import javax.swing.JScrollPane;
import javax.swing.JTable;

import java.awt.event.ActionEvent;
import java.awt.event.ActionListener;
import java.awt.event.MouseAdapter;
import java.awt.event.MouseEvent;

public class PageList extends JPanel {
	public JLabel label;
	public JLabel label_1;
	public JScrollPane scrollPane;
	public JTable table;
	private DefaultTableModel model;
	private JPopupMenu menu;
	List<Integer> list = new ArrayList<Integer>();

	/**
	 * Create the panel.
	 */
	public PageList() {
		setBackground(new Color(255, 255, 255));
		setSize(778, 431);
		setLayout(null);
		
		label = new JLabel("\uAD6C\uB9E4\uBAA9\uB85D");
		label.setFont(new Font("맑은 고딕", Font.BOLD, 20));
		label.setBounds(12, 10, 99, 40);
		add(label);
		
		label_1 = new JLabel("\uCD1D \uAE08\uC561: 0\uC6D0");
		label_1.setHorizontalAlignment(SwingConstants.RIGHT);
		label_1.setFont(new Font("맑은 고딕", Font.BOLD, 20));
		label_1.setBounds(276, 10, 490, 40);
		add(label_1);
		
		scrollPane = new JScrollPane();
		scrollPane.setBounds(12, 61, 754, 360);
		add(scrollPane);
		
		table = new JTable() {
			@Override
			public Class<?> getColumnClass(int column) {
				if(column==0)
					return Icon.class;
				return super.getColumnClass(column);
			}
		};
		table.addMouseListener(new TableMouseListener());
		scrollPane.setViewportView(table);
		
		addModel();
		load();
	}

	private void addModel() {
		model = new DefaultTableModel(" ,상품명,수량,단가,합계,구매날짜".split(","), 0);
		table.setModel(model);
		var render = new DefaultTableCellRenderer();
		render.setHorizontalAlignment(SwingConstants.CENTER);
		for (int i = 1; i < table.getColumnCount(); i++) {
			table.getColumnModel().getColumn(i).setCellRenderer(render);
		}
		table.getTableHeader().setBackground(Color.white);
		table.setRowHeight(80);
		menu = new JPopupMenu();
		var item = new JMenuItem("삭제");
		item.addActionListener(new ActionListener() {
			@Override
			public void actionPerformed(ActionEvent e) {
				if(table.getSelectedRow()!=-1) {
					try {
						BF.execute("delete from `order` where ono = "+list.get(table.getSelectedRow()));
						BF.msgInfo("삭제가 완료되었습니다.");
					} catch (SQLException e1) {
						e1.printStackTrace();
					}
					load();
				}
			}
		});
	}

	private void load() {
		model.setRowCount(0);
		int tot = 0;
		list.clear();
		try (var rs = BF.res("select ono, img,pname,o.quantity ,p.price, p.price*o.quantity, o.date from `order` o join product p using(pno) where uno = "+BF.uno)) {
			while(rs.next()) {
				model.addRow(new Object[]{BF.getIcon(rs.getBytes(2), 80, 80), rs.getString(3),rs.getInt(4)+"개", String.format("%,d원", rs.getInt(5)), String.format("%,d원", rs.getInt(6)), rs.getString(7)});
				tot+= rs.getInt(5);
				list.add(rs.getInt(1));
			}
		} catch (SQLException e) {
			e.printStackTrace();
		}
		label_1.setText(String.format("총 금액:%,d원", tot));
	}	
	private class TableMouseListener extends MouseAdapter {
		@Override
		public void mouseClicked(MouseEvent e) {
			if(SwingUtilities.isRightMouseButton(e)) {//e.ispopuptriger도 ㄱㄴ
				table.changeSelection(table.rowAtPoint(e.getPoint()), 0, false, false);
				
			}
		}
	}
}
