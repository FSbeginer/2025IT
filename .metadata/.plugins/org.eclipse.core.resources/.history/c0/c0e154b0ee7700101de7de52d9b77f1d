import javax.swing.JPanel;
import java.awt.Color;
import javax.swing.JLabel;
import java.awt.Font;
import java.awt.Graphics;
import java.awt.Graphics2D;
import java.awt.Image;
import java.awt.RenderingHints;
import java.sql.SQLException;
import java.util.ArrayList;
import java.util.List;
import java.util.Timer;

import javax.swing.JComboBox;
import javax.swing.JScrollPane;
import javax.swing.border.LineBorder;
import javax.swing.table.DefaultTableCellRenderer;
import javax.swing.table.DefaultTableModel;
import javax.swing.JTable;
import javax.swing.DefaultComboBoxModel;
import javax.swing.Icon;

import java.awt.event.MouseAdapter;
import java.awt.event.MouseEvent;
import java.awt.event.ItemListener;
import java.awt.event.ActionEvent;
import java.awt.event.ActionListener;
import java.awt.event.ItemEvent;

public class PageShip extends JPanel {
	public JLabel label;
	public JComboBox comboBox;
	public JScrollPane scrollPane;
	public JLabel label_1;
	private boolean act;
	public JLabel label_2;
	public JLabel label_3;
	public JLabel label_4;
	public JPanel panel;
	public JTable table;
	private DefaultTableModel model;
	private String where = "";
	List<Object[]> datas = new ArrayList<Object[]>();
	List<Image> imgs = new ArrayList<Image>();
	private int now;
	int[] idxs = {0,1,3,5};
	public JPanel panel_1;

	public PageShip() {
		setBackground(new Color(255, 255, 255));
		setSize(778, 431);
		setLayout(null);
		
		label = new JLabel("\uBC30\uC1A1\uC815\uBCF4");
		label.setFont(new Font("맑은 고딕", Font.BOLD, 20));
		label.setBounds(12, 10, 149, 35);
		add(label);
		
		comboBox = new JComboBox();
		comboBox.addItemListener(new ComboBoxItemListener());
		comboBox.setModel(new DefaultComboBoxModel(new String[] {"\uC804\uCCB4", "\uACB0\uC81C \uC644\uB8CC", "\uBC30\uC1A1\uC900\uBE44", "\uBC30\uC1A1 \uC911", "\uBC30\uC1A1 \uC644\uB8CC"}));
		comboBox.setBounds(617, 15, 149, 35);
		add(comboBox);
		
		panel_1 = new JPanel();
		panel_1.setBackground(new Color(255, 255, 255));
		panel_1.setBounds(12, 55, 754, 344);
		add(panel_1);
		panel_1.setLayout(null);
		
		scrollPane = new JScrollPane();
		scrollPane.setBounds(0, 10, 754, 144);
		panel_1.add(scrollPane);
		
		table = new JTable();
		table.addMouseListener(new TableMouseListener());
		scrollPane.setViewportView(table);
		
		label_1 = new JLabel("New label");
		label_1.setBounds(0, 164, 168, 119);
		panel_1.add(label_1);
		label_1.setBorder(new LineBorder(new Color(0, 0, 0)));
		
		label_2 = new JLabel("New label");
		label_2.setBounds(180, 164, 189, 24);
		panel_1.add(label_2);
		
		label_3 = new JLabel("New label");
		label_3.setBounds(180, 211, 189, 24);
		panel_1.add(label_3);
		
		label_4 = new JLabel("New label");
		label_4.setBounds(180, 259, 189, 24);
		panel_1.add(label_4);
		
		panel = new JPanel() {
			@Override
			protected void paintComponent(Graphics g) {
				super.paintComponent(g);
				Graphics2D g2 = (Graphics2D) g;
				g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
				int w = getWidth()/4;
				int h = getHeight()/2;
				
				int[] idxs = PageShip.this.idxs;
				for (int i = 1; i <= now; i++) {
					idxs[i]++;
				}
				for (int i = 0; i < 4; i++) {
					var image = imgs.get(idxs[i]).getScaledInstance(w, h, 1);
					g2.drawImage(image, w*i, 0, null);
					g2.fillOval(w/2+w*i-4, h+10, 8, 8);
				}
			}
		};
		panel.setBounds(381, 164, 373, 119);
		panel_1.add(panel);
		panel.setBackground(new Color(255, 255, 255));
		
		addmodel();
		load();
		getImage();
		if(model.getRowCount()>0) {
			table.changeSelection(0, 0, false, false);
			loadData(0);
			new javax.swing.Timer(1000, new ActionListener() {
				@Override
				public void actionPerformed(ActionEvent e) {
					act = !act;
					panel.repaint();
				}
			});
		}
		else {
			panel_1.removeAll();
			JLabel jl = new JLabel("배송정보가 없습니다.",0);
			jl.setFont(label.getFont());
			panel_1.add(jl);
			panel_1.repaint();
			panel_1.revalidate();
			comboBox.setVisible(false);
		}
	}

	private void getImage() {
		for (int i = 0; i < 4; i++) {
			for (int j = (i==0?2:1); j <= 2; j++) {
				imgs.add(BF.getIcon("delivery/"+i+j+".jpg").getImage());
			}
		}
	}

	private void load() {
		model.setRowCount(0);
		datas.clear();
		try (var rs = BF.res("select pno, ono, delivery, pname, o.quantity, price, price * o.quantity, o.date, img  from `order` o join product p using(pno) where uno = "+BF.uno +" "+where)) {
			while(rs.next()) {
				model.addRow(new Object[] {rs.getString(4),rs.getInt(5)+"개",String.format("%,d", rs.getInt(6)),String.format("%,d", rs.getInt(7)),rs.getString(8)});
				datas.add(new Object[] {rs.getInt(3), BF.getIcon(rs.getBytes("img"), label_1.getWidth(),label_1.getHeight()),rs.getString(4),String.format("%,d원 %d개",rs.getInt(6),rs.getInt(5)), String.format("%,d원", rs.getInt(7))});
			}
		} catch (SQLException e) {
			e.printStackTrace();
		}
	}

	private void addmodel() {
		model = new DefaultTableModel("상품,수량,단가,합계,주문일".split(","),0);
		table.setModel(model);
		DefaultTableCellRenderer render = new DefaultTableCellRenderer() {{setHorizontalAlignment(0);}};
		table.setDefaultRenderer(String.class, render);
	}

	private class TableMouseListener extends MouseAdapter {
		@Override
		public void mouseClicked(MouseEvent e) {
			loadData(table.getSelectedRow());
		}

	}
	private void loadData(int selectedRow) {
		var data = datas.get(selectedRow);
		now = (int)data[0];
		label_1.setIcon((Icon) data[1]);
		label_2.setText((String) data[2]);
		label_3.setText((String) data[3]);
		label_4.setText((String) data[4]);
	}
	private class ComboBoxItemListener implements ItemListener {
		public void itemStateChanged(ItemEvent e) {
			if(comboBox.getSelectedIndex()==0)
				where = "";
			else
				where = " and delivery = "+(comboBox.getSelectedIndex()-1);
			load();
		}
	}
}
