	private void load() {
		panel.removeAll();
		pps.clear();
		nos.clear();
		try (var rs = BF.res(
				"select cno,pno,p.img, p.pname, p.price, c.quantity, p.price * c.quantity from cart c join product p using(pno) where uno="+BF.uno)) {
			int i = 0;
			int w = (scrollPane.getWidth() - 20) / 3, h = 80;
			while (rs.next()) {
				PanelShop pp = new PanelShop(BF.getIcon(rs.getBytes(3), 100, 70), rs.getString(4), rs.getInt(5),
						rs.getInt(6), rs.getInt(7));
				pp.setSize(w, h);
				pp.setLocation(w * (i % 3), h * (i / 3));
				int sum = rs.getInt(7);
				int cno = rs.getInt(1);
				int pno = rs.getInt(2);
				int[] n = { cno, pno };
				pp.checkBox.addItemListener(new ItemListener() {
					@Override
					public void itemStateChanged(ItemEvent e) {
						if (pp.checkBox.isSelected()) {
							tot += sum;
							nos.add(n);
						} else {
							tot -= sum;
							nos.remove(n);
						}
						boolean all = true;
						for (var pp : pps) {
							if (!pp.checkBox.isSelected()) {
								all = false;
								break;
							}
						}
						checkBox.setSelected(all);
						label_1.setText(String.format("ÃÑ±Ý¾×:%,d¿ø", tot));
					}
				});;
				pps.add(pp);
				panel.add(pp);
				i++;
			}
		} catch (SQLException e) {
			e.printStackTrace();
		}

		panel.repaint();
		panel.revalidate();
	}

	private class Button_1ActionListener implements ActionListener {
		public void actionPerformed(ActionEvent e) {
			
		}
	}
	private class CheckBoxItemListener implements ItemListener {
		public void itemStateChanged(ItemEvent e) {
			if (checkBox.isSelected())
				for (var pp : pps) {
					if (!pp.checkBox.isSelected()) {
						pp.checkBox.setSelected(true);
					}
				}
		}
	}
