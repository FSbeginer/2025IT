	private void loadData() {
		try (var rs = res("select * from category")) {
			comboBox.addItem(rs.getString("cnam"));
		} catch (SQLException e) {
			e.printStackTrace();
		}
		try {
			var rs = res("select * from product where pno = " + pno);
			rs.next();
			label.setIcon(getIcon(rs.getBytes("img"), label.getWidth(), label.getHeight()));
			comboBox.setSelectedIndex(rs.getInt("cno") - 1);
			textField.setText(rs.getString("pname"));
			textField_1.setText(rs.getString("description"));
			textField_2.setText(rs.getString("price"));
			textField_3.setText(rs.getString("quantity"));
			button.setText("수정");
		} catch (SQLException e) {
			e.printStackTrace();
		}
	}

	private class ButtonActionListener implements ActionListener {
		public void actionPerformed(ActionEvent e) {
			if(textField.getText().isBlank()||textField_1.getText().isBlank()||textField_2.getText().isBlank()||textField_3.getText().isBlank()) {
				msgErr("빈칸이 있습니다.");
				return;
			}
			
			if(label.getIcon()==null) {
				msgErr("이미지를 선택해주세요.");
				return;
			}
				
			try {
				int price = Integer.parseInt(textField_2.getText());
				int n = Integer.parseInt(textField_3.getText());
				if(price<1||n<1) {
					msgErr("가격과 수량을 1 이상의 숫자로 입력하세요.");
					return;
				}
				if (pno != 0) {
					ByteArrayOutputStream bios = new ByteArrayOutputStream();
					Image img = ((ImageIcon)label.getIcon()).getImage();
					BufferedImage bi = new BufferedImage(img.getWidth(null), img.getHeight(null), 2);
					bi.createGraphics().drawImage(img, 0, 0, null);
					
					var pre = pre("update product set cno = ?, pname = ?, description = ?, price = ?, quantity = ?, img = ?");
					preSet(pre, comboBox.getSelectedIndex()+1, textField.getText(), textField_1.getText(), textField_2.getText(), textField_3.getText());
					pre.execute();
					msgInfo("수정이 완료되었습니다.");
					dispose();
				}
				else {
					
				}
			} catch (Exception e1) {
				msgErr("가격과 수량을 1 이상의 숫자로 입력하세요.");
				return;
			}
		}
	}
	private class LabelMouseListener extends MouseAdapter {
		@Override
		public void mouseClicked(MouseEvent e) {
			if(e.getClickCount()==2) {
				JFileChooser jfc = new JFileChooser();
				jfc.setMultiSelectionEnabled(false);
				jfc.setFileFilter(new FileNameExtensionFilter("JPG Images", "jpg"));
				if(jfc.showOpenDialog(null)==jfc.APPROVE_OPTION) {
					try {
						Image img = ImageIO.read(jfc.getSelectedFile());
						label.setIcon(new ImageIcon(img.getScaledInstance(label.getWidth(), label.getHeight(), 1)));
					} catch (IOException e1) {
						e1.printStackTrace();
					}
				}
			}
		}
