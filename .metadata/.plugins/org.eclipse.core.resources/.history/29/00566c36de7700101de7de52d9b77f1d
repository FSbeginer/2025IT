import javax.swing.JPanel;
import javax.swing.JCheckBox;

import java.awt.Color;
import javax.swing.JLabel;
import java.awt.Font;
import java.awt.event.ActionEvent;
import java.awt.event.ActionListener;
import java.awt.event.ItemEvent;
import java.awt.event.ItemListener;
import java.sql.SQLException;
import java.time.LocalDate;
import java.util.ArrayList;
import java.util.List;

import javax.swing.SwingConstants;
import javax.swing.JScrollPane;
import javax.swing.JButton;

public class PageShop extends JPanel {
	public JPanel panel;
	public JCheckBox checkBox;
	public JLabel label;
	public JLabel label_1;
	public JScrollPane scrollPane;
	public JButton button;
	public JButton button_1;
	List<PanelShop> pps = new ArrayList<PanelShop>();
	List<int[]> nos = new ArrayList<int[]>();
	int tot;

	public PageShop() {
		setBackground(new Color(255, 255, 255));
		setSize(778, 431);
		setLayout(null);

		checkBox = new JCheckBox("\uC804\uCCB4 \uC120\uD0DD");
		checkBox.addActionListener(new CheckBoxActionListener());
		checkBox.setBackground(new Color(255, 255, 255));
		checkBox.setBounds(12, 402, 115, 23);
		add(checkBox);

		label = new JLabel("\uC7A5\uBC14\uAD6C\uB2C8");
		label.setFont(new Font("맑은 고딕", Font.BOLD, 20));
		label.setBounds(12, 37, 115, 30);
		add(label);

		label_1 = new JLabel("\uCD1D\uAE08\uC561: 0\uC6D0");
		label_1.setHorizontalAlignment(SwingConstants.RIGHT);
		label_1.setFont(new Font("맑은 고딕", Font.BOLD, 20));
		label_1.setBounds(495, 37, 271, 30);
		add(label_1);

		scrollPane = new JScrollPane();
		scrollPane.setBounds(12, 76, 754, 320);
		add(scrollPane);

		panel = new JPanel();
		panel.setBackground(new Color(255, 255, 255));
		scrollPane.setViewportView(panel);
		panel.setLayout(null);

		button = new JButton("\uAD6C\uB9E4\uD558\uAE30");
		button.addActionListener(new ButtonActionListener());
		button.setBounds(669, 402, 97, 23);
		add(button);

		button_1 = new JButton("\uC0AD\uC81C");
		button_1.addActionListener(new Button_1ActionListener());
		button_1.setBounds(596, 402, 61, 23);
		add(button_1);

		load();
	}

	private void load() {
		panel.removeAll();
		pps.clear();
		nos.clear();
		checkBox.setSelected(false);
		try (var rs = BF.res(
				"select ctno,pno,p.img, p.pname, p.price, c.quantity, p.price * c.quantity from cart c join product p using(pno) where uno="
						+ BF.uno)) {
			int i = 0;
			int w = (scrollPane.getWidth() - 20) / 3, h = 80;
			while (rs.next()) {
				PanelShop pp = new PanelShop(BF.getIcon(rs.getBytes(3), 100, 70), rs.getString(4), rs.getInt(5),
						rs.getInt(6), rs.getInt(7));
				pp.setSize(w, h);
				pp.setLocation(w * (i % 3), h * (i / 3));
				int sum = rs.getInt(7);
				int ctno = rs.getInt(1);
				int pno = rs.getInt(2);
				int[] n = { ctno, pno, rs.getInt(6) };
				pp.checkBox.addItemListener(new ItemListener() {
					@Override
					public void itemStateChanged(ItemEvent e) {
						if (pp.checkBox.isSelected()) {
							tot += sum;
							nos.add(n);
						} else {
							tot -= sum;
							nos.remove(n);
						}
						boolean all = true;
						for (var pp : pps) {
							if (!pp.checkBox.isSelected()) {
								all = false;
								break;
							}
						}
						checkBox.setSelected(all);
						label_1.setText(String.format("총금액:%,d원", tot));
					}
				});
				;
				pps.add(pp);
				panel.add(pp);
				i++;
			}
		} catch (SQLException e) {
			e.printStackTrace();
		}

		panel.repaint();
		panel.revalidate();
	}

	private class Button_1ActionListener implements ActionListener {
		public void actionPerformed(ActionEvent e) {
			if(nos.size()==0) {
				BF.msgErr("삭제할 상품을 선택하세요.");
				return;
			}
			for (int[] is : nos) {
				try {
					BF.execute("delete from cart where ctno = "+is[0]);
				} catch (SQLException e1) {
					e1.printStackTrace();
				}
			}
			load();
		}
	}

	
	private class CheckBoxActionListener implements ActionListener {
		public void actionPerformed(ActionEvent e) {
			if (checkBox.isSelected())
				for (var pp : pps) {
					pp.checkBox.setSelected(true);
				}
			else
				for (var pp : pps) {
					pp.checkBox.setSelected(false);
				}
		}
	}
	private class ButtonActionListener implements ActionListener {
		public void actionPerformed(ActionEvent e) {
			if(nos.size()==0) {
				BF.msgErr("구매할 상품을 선택하세요.");
				return;
			}
			for (int[] is : nos) {
				try {
					var rs =BF.res("select quantity from product where pno = "+is[1]);
					if(!rs.next()) {
						BF.msgErr("재고가 부족합니다.");
						return;
					}
				} catch (SQLException e1) {
					e1.printStackTrace();
				}
			}
			for (int[] is : nos) {
				try {
					BF.execute("update product set quantity = quantity - "+is[2]);
					var pre = BF.pre("insert into `order` values(0,?,?,?,?,0,0)");
					BF.preSet(pre, BF.uno, is[1], is[2], LocalDate.now());
					pre.execute();
				} catch (SQLException e1) {
					e1.printStackTrace();
				}
			}
		}
	}
}
