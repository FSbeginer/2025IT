import java.awt.Graphics;
import java.awt.Graphics2D;
import java.awt.RenderingHints;
import java.awt.geom.Ellipse2D;
import java.sql.SQLException;
import java.util.ArrayList;
import java.util.List;
import java.util.Random;

import javax.swing.JPanel;
import java.awt.Color;

public class 버블패널 extends JPanel {
	Random rand = new Random();
	List<Boubble> balls =new ArrayList<버블패널.Boubble>();
	/**
	 * Create the panel.
	 */
	public 버블패널() {
		setBackground(new Color(255, 255, 255));
		setSize(754, 374);
		System.out.println(1);
		int max = 0;
		try (var rs = BF.res("select cnam, rank() over(order by count(*) desc) - 1, count(*) from product p join `order` o using(pno) join category using(cno) group by cno;")) {
			while(rs.next()) {
				if(max==0) max = rs.getInt(3);
				double size = max*3 * Math.pow(0.9, rs.getInt(2));
				balls.add(new Boubble(0, 0, size, rs.getString(1), Color.getHSBColor(rand.nextFloat(), 0.6f, 0.9f)));
			}
		} catch (SQLException e) {
			e.printStackTrace();
		}
		
		for (int i = 0; i < balls.size(); i++) {
			var b1 = balls.get(i);
			
			boolean nope = false;
			double x,y;
			do {
				nope = false;
				x = rand.nextInt((int) (getWidth()-b1.width));
				y = rand.nextInt((int) (getHeight()-b1.width));
				for (int j = 0; j < i; j++) {
					var b2 = balls.get(j);
					double dist = Math.hypot(x+b1.height/2-b2.getCenterX(), y+b1.height/2-b2.getCenterY());
					if(dist<b1.width/2+b2.width/2) {
						nope = true;
						break;
					}
				}
			} while(nope);
			b1.x = x;
			b1.y = y;
		}
	}

	@Override
	protected void paintComponent(Graphics g) {
		super.paintComponent(g);
		Graphics2D g2 = (Graphics2D) g;
		g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
		
		for (Boubble boubble : balls) {
			g2.setColor(boubble.c);
			g2.fill(boubble);
			g2.setColor(Color.black);
			g2.draw(boubble);
			g2.drawString(boubble.name, (int)boubble.getCenterX()-g2.getFontMetrics().stringWidth(boubble.name)/2, (int) boubble.getCenterY());
		}
		
		for (int i = 0; i < balls.size(); i++) {
			var b1 = balls.get(i);
			b1.moveBall();
			for (int j = i+1; j < balls.size(); j++) {
				var b2 = balls.get(j);
				double dx = b1.getCenterX()-b2.getCenterX();
				double dy = b1.getCenterY() -b2.getCenterY();
				double dist = Math.hypot(dx, dy);
				double mindist =b1.width/2+b2.width/2;
				
				if(dist<mindist) {
					double[] normal = {dx/dist, dy/dist};
					double[] normal2 = {-normal[0], -normal[1]};
					b1.x -= normal[0] * (dist-mindist) *0.5;
					b1.y -= normal[1] * (dist-mindist) *0.5;
					b2.x -= normal2[0] * (dist-mindist) *0.5;
					b2.y -= normal2[1] * (dist-mindist) *0.5;
					double dot = normal[0]*b1.vel[0]+b1.vel[1]*normal[1];
					double[] newV1 = {b1.vel[0]-2*normal[0]*dot,b1.vel[1]-2*normal[1]*dot};
					
					double dot2 = normal2[0]*b2.vel[0]+b2.vel[1]*normal2[1];
					double[] newV2 = {b2.vel[0]-2*normal2[0]*dot2,b2.vel[1]-2*normal2[1]*dot2};
					b1.vel = newV1;
					b2.vel = newV2;
				}
			}
		}
		try {
			Thread.sleep(1);
		} catch (InterruptedException e) {
			e.printStackTrace();
		}
		repaint();
	}
	
	class Boubble extends Ellipse2D.Double {
		double[] vel = {rand.nextInt(2)+1, rand.nextInt(2)+1};
		String name;
		Color c;
		public Boubble(double x, double y, double size, String name, Color c) {
			super(x, y, size, size);
			this.name = name;
			this.c=c;
		}
		public void moveBall() {
			if(x+vel[0]<0 || x+vel[0]>버블패널.this.getWidth()-width) {
				vel[0] = -vel[0];
			}
			if(y+vel[1]<0||y+vel[1]>버블패널.this.getHeight()-width) {
				vel[1] = -vel[1];
			}
			x += vel[0];
			y += vel[1];
		}
	}
}
