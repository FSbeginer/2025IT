	private void getdata() {
		try (var rs = res("SELECT pno, img, pname, `description`, cnam, price, avg(rating), p.quantity FROM product p left join `order` o using(pno) left join review using(ono) join category using(cno) where pno = "+pno)) {
			rs.next();
			img = getIcon(rs.getBytes(2), label.getWidth(), label.getHeight()).getImage();
			label_1.setText("상품명:"+rs.getString(3));
			label_2.setText("<html>설명:"+rs.getString(4));
			label_3.setText("카테고리:"+rs.getString(5));
			label_4.setText(String.format("가격:%,d",rs.getInt(6)));
			label_5.setText(String.format("평점:%.1f", rs.getDouble(7)));
			quantity = rs.getInt(8);
		} catch (SQLException e) {
			e.printStackTrace();
		}
	}

