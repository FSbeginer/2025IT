public class 막대패널 extends JPanel {
	public JLabel label;
	public JPanel panel;
	private int cno = 1;
	List<String> category = new ArrayList<String>();
	List<Object[]> datas = new ArrayList<Object[]>();
	
	public 막대패널() {
		setBackground(new Color(255, 255, 255));
		setSize(754, 374);
		setLayout(null);
		
		label = new JLabel("New label");
		label.addMouseWheelListener(new LabelMouseWheelListener());
		label.setFont(new Font("맑은 고딕", Font.BOLD, 30));
		label.setBorder(new LineBorder(new Color(0, 0, 0)));
		label.setOpaque(true);
		label.setBackground(new Color(255, 255, 255));
		label.setHorizontalAlignment(SwingConstants.CENTER);
		label.setBounds(278, 10, 175, 50);
		add(label);
		
		panel = new JPanel() {
			@Override
			public JToolTip createToolTip() {
				JToolTip tool = new JToolTip();
				tool.setBackground(Color.white);
				return tool;
			}
			@Override
			protected void paintComponent(Graphics g) {
				super.paintComponent(g);
				int w = getWidth()/14;
				int maxh = getHeight()-20;
				int bx =0, by = maxh; 
				for (int i = 0; i < datas.size(); i++) {
					var data = datas.get(i);
					
				}
			}
		};
		panel.setBackground(new Color(255, 255, 255));
		panel.setBounds(29, 67, 691, 277);
		add(panel);
		
		try (var rs = BF.res("select cnam from category")) {
			while(rs.next())
				category.add(rs.getString(1));
		} catch (SQLException e) {
			e.printStackTrace();
		}
		getData();
	}


	private void getData() {
		datas.clear();
		try (var rs = BF.res("select pname, rank() over(order by count(*) desc), count(*), description from product p join `order` o using(pno) where cno = "+cno+" group by pno;")) {
			while(rs.next()) {
				datas.add(new Object[] {rs.getString(1), rs.getInt(3), rs.getInt(2)==1?Color.red:Color.blue, rs.getString(4)});
			}
		} catch (SQLException e) {
			e.printStackTrace();
		}
		panel.repaint();
	}

	private class LabelMouseWheelListener implements MouseWheelListener {

		public void mouseWheelMoved(MouseWheelEvent e) {
			int dx = e.getWheelRotation()<0?1:-1;
			cno = Math.max(1, Math.min(category.size(), cno+dx));
			getData();
		}
	}
}
