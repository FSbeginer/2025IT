	private void load() {
		try (var rs = BF.res("SELECT pno, img, pname, price, count(*) cnt, avg(rating) FROM product p join `order` o using(pno) left join review using(ono) group by pno order by cnt;")) {
			int w = (panel.getWidth()-40)/5;
			int h = 140, i =0;
			
			while(rs.next()) {
				PanelMain pp = new PanelMain(BF.getIcon(rs.getBytes(2), 100,70),rs.getString(3), rs.getInt(4), rs.getInt(5), rs.getDouble(6));
				pp.setSize(w, h);
				pp.setLocation((w+10)*(i%3), (h+5)*(i/3));
				int pno = rs.getInt(1);
				pp.label.addMouseListener(new MouseAdapter() {
					@Override
					public void mouseClicked(MouseEvent e) {
						if(BF.isAdmin&&e.getClickCount()==2) {
							
						}
					}
				});
				panel.add(pp);
				i++;
			}
		} catch (SQLException e) {
			e.printStackTrace();
		}
	}
	private class ComboBoxActionListener implements ActionListener {
		public void actionPerformed(ActionEvent e) {
			
		}
	}
