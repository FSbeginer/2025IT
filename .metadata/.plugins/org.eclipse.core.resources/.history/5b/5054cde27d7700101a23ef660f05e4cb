	private void addCate() {
		addLabel("전체", 0);
		try (var rs = BF.res("select * from category")) {
			while(rs.next()) {
				addLabel(rs.getString("cnam"), rs.getInt("cno"));
			}
		} catch (SQLException e) {
		}
	}

	private void addLabel(String cate, int cno) {
		JLabel jl = new JLabel(cate, 0);
		jl.setFont(new Font("맑은 고딕", Font.BOLD, 15));
		jl.setBackground(Color.white);
		jl.addMouseListener(new MouseAdapter() {
			@Override
			public void mouseClicked(MouseEvent e) {
				if(cno==0)
					PageSearch.this.cate = "";
				else
					PageSearch.this.cate = " and cno = "+cno+" ";
				for (JLabel jLabel : lbls) {
					jLabel.setOpaque(false);
					jLabel.setForeground(Color.black);
				}
				jl.setOpaque(true);
				jl.setForeground(BF.blue);
			}
		});
		lbls.add(jl);
		panel_2.add(jl);
	}

	private void load() {
		panel_3.removeAll();
		int w = (scrollPane.getWidth()-30-25)/4;
		int h = (scrollPane.getHeight()-10)/2;
		try (var rs = BF.res("SELECT pno, img, pname, price, count(*) cnt, avg(rating) FROM product p left join `order` o using(pno) left join review using(ono) where true "+cate+pname+price+" group by pno "+order)) {
			int i = 0;
			while(rs.next()) {
				PanelMain pm = new PanelMain(BF.getIcon(rs.getBytes(2),100,70), rs.getString(3), rs.getInt(4), rs.getInt(5), rs.getDouble(6));
				pm.setSize(w,h);
				pm.setLocation((w+10)*(i%4), (h+10)*(i/4));
				int pno = rs.getInt(1);
				pm.addMouseListener(new MouseAdapter() {
					@Override
					public void mouseClicked(MouseEvent e) {
						if(BF.uno==0&&!BF.isAdmin) {
							BF.msgErr("로그인 후 사용가능합니다");
							return;
						}
						((BF)SwingUtilities.getWindowAncestor(pm)).showPage(new InformationForm(pno), "InformationForm");
					}
				});
				panel_3.add(pm);
				i++;
			}
			panel_3.setPreferredSize(new Dimension(0,(h+10)*((i+3)/4)));
		} catch (SQLException e) {
			e.printStackTrace();
		}
		panel_3.repaint();
		panel_3.revalidate();
	}
	private class Button_1ActionListener implements ActionListener {
		public void actionPerformed(ActionEvent e) {
